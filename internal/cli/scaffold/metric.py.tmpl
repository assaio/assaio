#!/usr/bin/env python3
"""{{.Name}}: an assaio metric plugin (ADR 0004, protocol {{.Protocol}}).

Two verbs, both with ASSAIO_METRIC_PROTOCOL=1 in the environment:

  {{.Name}} describe   nothing on stdin; a handshake line and what this metric reads
  {{.Name}} analyze    the projected window on stdin; a handshake line and one Result

The documents assaio accepts and refuses are published in docs/conformance/, which you can run
in your own CI without the assaio binary.
"""
import json
import sys

NAME = "{{.Name}}"
PROTOCOL = {{.Protocol}}

# What this metric reads, and nothing else is sent. Name a capability you do not read and you
# pay for it on every run; read a column you did not project and it is simply absent -- which is
# never a zero. `needs` is required; `fields` and `where` are optional narrowings of it.
DECLARATION = {
    "needs": ["usage"],
    "fields": {"usage": ["day", "tool", "in", "out"]},
}


def handshake():
    print(json.dumps({"assaio_metric": PROTOCOL, "name": NAME}))


def describe():
    handshake()
    print(json.dumps(DECLARATION))


def analyze():
    window = json.load(sys.stdin)
    # projection.rows says how many rows you were sent and how many the window held before your
    # own predicates ran. Anything you publish as a share is a share of the first, not the
    # second, and saying so is your job -- assaio cannot know which one your figure means.
    rows = window["usage"]
    tokens = sum(r["in"] + r["out"] for r in rows)

    handshake()
    print(json.dumps({
        "title": "TODO: name this metric",
        "layer": "activity",
        "read": {"key": "neutral", "label": "TODO"},
        "howToRead": "TODO: one sentence telling a reader how to read the figure below, "
                     "including what would make it mean nothing.",
        "takeaway": "TODO: the one sentence a reader acts on. This skeleton has not decided "
                    "anything yet, which is why its verdict is neutral.",
        "figures": [{"label": "tokens in window", "value": f"{tokens:,}"}],
        "confidence": {"samples": len(rows), "samplesUnit": "usage rows"},
    }))


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else ""
    if verb == "describe":
        describe()
    elif verb == "analyze":
        analyze()
    else:
        sys.exit(f"usage: {sys.argv[0]} describe|analyze")


if __name__ == "__main__":
    main()
